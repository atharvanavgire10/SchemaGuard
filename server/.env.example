# SchemaGuard Server Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 5000)
PORT=5000

# Client origin for CORS (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string (optional - app runs in memory mode without it)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/schemaguard

# PostgreSQL SSL (set to 'true' for cloud databases)
# DATABASE_SSL=false

# GitHub Personal Access Token (optional - required for PR comments)
# Get from: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos)
# GITHUB_TOKEN=ghp_your_token_here

# Node environment
NODE_ENV=development
